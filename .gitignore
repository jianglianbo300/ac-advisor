# 虚拟环境
.venv/

# Python 缓存
__pycache__/
*.pyc

# Hermes 临时文件
.hermes-tmp.*

# 运行时状态（每次运行自动生成，不入库）
ac_state.json
forecast.json

# 设备凭据（含净化器 IP + token，禁止入库）
miio_config.json

# 版本备份 *.bak-* / *.bak_* / *.bak.* / *.bak
# 2026-09-27 补：原规则只有 *.bak-*（连字符），而实际命名大量用下划线
# （.bak_before_xxx_时间戳），导致 6 个备份文件长期未被忽略、裸奔在
# git status 里 —— 一次 `git add -A` 就会入库。
*.bak-*
*.bak_*
*.bak.*
*.bak


# 滤网状态（运行时生成）
filter_state.json

# 运行时日志
ac_watch.log
_winddown_log.txt

# 子代理运行输出快照（omp/pi 审计时落盘的 stdout 转储，一次性产物，不入库）
_*_run_stdout.log

# 环境/凭据（API key 统一存 .env，review_*.py 从环境读取）
.env
# QR 扫码会话缓存（含 passToken，禁止入库）
qr_session.json
qr_login.log
samples.jsonl

# 运行周期数据（v8.6 数据层，每次开关机追加，不入库）
cycle_log.jsonl

# 效率分析报告（02:00 cron 每日生成，不入库）
ac_efficiency_report.json

# 看门狗状态（ac_watchdog.py 运行时生成）
ac_watchdog_state.json

# 修复效果周快照（cron ce70b33967b6 追加，不入库）
_effect_snapshots.jsonl

# 热模型学习数据（ac_watch/ac_advisor 运行时生成，不入库）
ac_thermal.json

# 阈值自学习数据（evaluate_and_learn 运行时生成，不入库）
ac_learned.json

# 家庭生活系统运行时状态（home_living.py 生成，不入库）
home_state.json

# 通风周期状态机（vent_cycle_step 生成，不入库）
vent_cycle_state.json


# prime-agent 排查残留（2026-08-28 审计清理）
gh_*.json
pa_readme.md
pa_rel.json
_audit_plan_*.py
_check_conn.py
_ac_on_now.py

# MiMo Code 本地工具状态（.cron-lock/node_modules，不入库）
.mimocode/

# 云化改造：二维码登录会话图片（含登录信息，不入库）
qr_login.png
qr_login_url.png
qr2ascii.py

# ── 外审工作区产物（2026-09-26）─────────────────────────────
# 审计运行产物体积大（单次 .raw 可达 6 MB）且含完整推理链，
# 其中可能包含源码上下文；只保留 mk_slices.py / verify_findings.py /
# severity_recheck.md 等**可复现工具**，产物一律不入库。
_audit_slices/results/
_audit_slices/*.raw
_audit_slices/_t_*.json
_audit_slices/_t_*.jsonl
_audit_slices/_t_*.log
_audit_slices/__pycache__/
