# 虚拟环境
.venv/

# Python 缓存
__pycache__/
*.pyc

# Hermes 临时文件
.hermes-tmp.*

# 运行时状态（每次运行自动生成，不入库）
ac_state.json
forecast.json

# 设备凭据（含净化器 IP + token，禁止入库）
miio_config.json

# 版本备份 *.bak-*
*.bak-*

# 滤网状态（运行时生成）
filter_state.json

# 运行时日志
ac_watch.log
_winddown_log.txt

# 环境/凭据（API key 统一存 .env，review_*.py 从环境读取）
.env
# QR 扫码会话缓存（含 passToken，禁止入库）
qr_session.json
qr_login.log
samples.jsonl

# 运行周期数据（v8.6 数据层，每次开关机追加，不入库）
cycle_log.jsonl

# 效率分析报告（02:00 cron 每日生成，不入库）
ac_efficiency_report.json

# 看门狗状态（ac_watchdog.py 运行时生成）
ac_watchdog_state.json

# 修复效果周快照（cron ce70b33967b6 追加，不入库）
_effect_snapshots.jsonl
